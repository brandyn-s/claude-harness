{
  "description": "safety-net plugin hooks",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook",
              "bash-pretooluse-dispatcher.py"
            ],
            "timeout": 30
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook",
              "config-guard.py"
            ],
            "timeout": 30
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook",
              "result-injection-guard.py"
            ],
            "timeout": 30
          }
        ],
        "matcher": "mcp__.*"
      }
    ]
  }
}
