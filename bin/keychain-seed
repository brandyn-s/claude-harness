#!/usr/bin/env python3
"""Seed the macOS Keychain with secrets for env_loader.

Stores each secret as a generic password with service "claude/<NAME>" and
account $USER, which hooks/session_start_modules/env_loader.py resolves at
SessionStart (env var first, Keychain second).

Usage:
  bin/keychain-seed NAME [NAME ...]   # hidden interactive prompt per name
  echo 'NAME=value' | bin/keychain-seed --stdin   # one NAME=value per line

Values never appear in process argv (FORBIDDEN
wide_process_listing_with_commandline... in rules/platform-constraints.md):
commands are piped to `security -i` over stdin. Re-running updates the
existing item (-U).
"""
from __future__ import annotations

import getpass
import os
import subprocess
import sys


def _security_quote(value: str) -> str:
    """Quote a value for a `security -i` command line."""
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def _seed(pairs: list[tuple[str, str]]) -> int:
    account = os.environ.get("USER") or os.environ.get("LOGNAME") or "claude"
    lines = []
    for name, value in pairs:
        lines.append(
            f"add-generic-password -U -a {_security_quote(account)} "
            f"-s {_security_quote(f'claude/{name}')} -w {_security_quote(value)}"
        )
    r = subprocess.run(
        ["security", "-i"],
        input=("\n".join(lines) + "\n").encode("utf-8"),
        capture_output=True,
        timeout=30,
    )
    if r.returncode != 0:
        sys.stderr.write(r.stderr.decode("utf-8", errors="replace"))
        return r.returncode
    for name, _ in pairs:
        print(f"seeded claude/{name}")
    return 0


def main(argv: list[str]) -> int:
    if sys.platform != "darwin":
        print("keychain-seed is macOS-only (uses the security CLI).", file=sys.stderr)
        return 1
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2

    pairs: list[tuple[str, str]] = []
    if argv == ["--stdin"]:
        for line in sys.stdin.read().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            name, sep, value = line.partition("=")
            if not sep or not name.strip() or not value:
                print(f"skipping malformed line: {line.split('=')[0]}...", file=sys.stderr)
                continue
            pairs.append((name.strip(), value))
    else:
        for name in argv:
            value = getpass.getpass(f"{name}: ")
            if value:
                pairs.append((name, value))

    if not pairs:
        print("nothing to seed", file=sys.stderr)
        return 2
    return _seed(pairs)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
