      "Bash(pip install:*)",
      "Bash(pip show:*)",
      "Bash(python3 *)",
      "Bash(python3 -c \"import json,sys; d=json.load\\(sys.stdin\\); [print\\(f\\\\\"{c['commit']['author']['date'][:10]} {c['sha'][:7]} {c['commit']['message'].splitlines\\(\\)[0][:90]}\\\\\"\\) for c in d]\")",
      "Bash(python3 -c \"import json,sys; d=json.load\\(sys.stdin\\); [print\\(f\\\\\"{t['type']:5} {t['path']}\\\\\"\\) for t in d['tree']]\")",
      "Bash(python:*)",
      "Bash(swift run *)",
      "Bash(wait)",
