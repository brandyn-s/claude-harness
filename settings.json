    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)",
      "Read(**/secrets.*)",
      "Read(~/.claude/daemon/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.credentials.json)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(*chmod 777*)",
      "Bash(*curl*| bash*)",
      "Bash(*curl*| sh*)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(**/CLAUDE.md)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state rm:*)",
      "Bash(aws iam put-role-policy:*)",
      "Bash(aws iam attach-role-policy:*)",
      "Bash(aws iam put-user-policy:*)",
      "Bash(aws iam create-access-key:*)",
      "Bash(aws ecr batch-delete-image:*)",
      "Bash(aws secretsmanager put-secret-value:*)",
      "Bash(aws secretsmanager delete-secret:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws ssm put-parameter:*)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git stash drop:*)",
      "mcp__github__set_branch_protection",
      "mcp__github__toggle_enforce_admins",
      "mcp__github__trigger_workflow",
      "mcp__paloalto__update_custom_url_categories",
      "mcp__paloalto__push_candidate_config",
      "mcp__paloalto__update_security_rules",
      "mcp__crowdstrike__contain_host",
      "mcp__crowdstrike__falcon_add_ioc",
      "mcp__tailscale__set_policy_file"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/Documents",
      "/tmp/claude"
    ]
  },
  "model": "claude-fable-5[1m]",
  "fallbackModel": [
    "claude-opus-5[1m]"
  ],
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "linear-server"
  ],
  "skillOverrides": {
    "capture": "name-only",
    "distill": "name-only",
    "garden": "name-only",
    "mega-capture": "name-only",
    "mega-distill": "name-only",
    "retro": "name-only",
    "ship": "name-only",
    "superplan": "name-only"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay",
            "args": [
              "/System/Library/Sounds/Sosumi.aiff"
            ]
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay",
            "args": [
              "/System/Library/Sounds/Glass.aiff"
            ]
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "config-change-validate.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "post-write-edit.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "skill-ref-validator.py"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__tavily__tavily_research",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "tavily-research-poll.py"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "post-merge-sync.py"
            ],
            "if": "Bash(gh pr merge*)",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "output-secret-redact.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "result-injection-guard.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*|Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "loop-detector.py"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "bash-security-audit.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__codebase-memory-mcp__search_code|mcp__codebase-memory-mcp__search_code_semantic|mcp__codebase-memory-mcp__query_graph|mcp__codebase-memory-mcp__search_graph|mcp__memory-search__memory_search",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "query-routing-log.py"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "creative-output-grounding-check.py"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "mcp-truncation-signal-guard.py"
            ],
            "timeout": 8
          }
        ],
        "matcher": "mcp__.*"
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*|Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "post-failure-guide.py"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "bash-error-classifier.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "The Edit failed. If 'File has been modified since read': a hook modified the file between your Read and Edit. Re-read the file with Read, then retry Edit. For files in ~/.claude/, use a Python script via Bash instead (bypasses hook cycle). If 'String to replace not found': re-read and use the exact text from the file.",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__msgraph__graph_request|mcp__remote-msgraph__graph_request",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before this graph_request call: (A) GATE CHECK — graph_request is a wildcard GET tool. Check if a scoped tool exists for this query (e.g., msgraph_list_users, msgraph_get_security_incident). If a scoped tool can do this, respond {\"decision\":\"block\",\"reason\":\"Use the scoped tool [name] instead of the wildcard graph_request.\"}. (B) REASON — In one sentence, state what data you need and why no scoped tool covers it. (C) VERIFY — (1) Path uses .us endpoints (GCC High, not .com), (2) $top is set for list queries, (3) OData $filter syntax is correct. If all checks pass, respond {\"ok\": true}. Context: $ARGUMENTS",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__remote-msgraph__call_tool|mcp__msgraph__call_tool",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "kql-schema-hint.py"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "bash-security-guard.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "git-destructive-checkout-guard.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "bash-tail-buffering-guard.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "git-empty-push-guard.py"
            ],
            "if": "Bash(git push*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "staged-additions-guard.py"
            ],
            "if": "Bash(git commit*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "pr-duplicate-preflight.py"
            ],
            "if": "Bash(gh pr create*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "zsh-dialect-guard.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "destructive-ops-guard.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "search-path-guard.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
              "pre-agent-dispatch.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook",
            "args": [
