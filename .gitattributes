# Collapse the generated plugin tree in GitHub diffs and exclude it from
# language stats. It is assembled by scripts/build-marketplace.py from the
# sources in skills/, hooks/, agents/ and bin/ -- reviewers should read those.
marketplace/** linguist-generated=true

# Normalise line endings so the generated bundles are byte-stable across hosts;
# CI compares the rebuilt tree against the committed one.
* text=auto eol=lf
